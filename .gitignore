# Binaries
bin/
*.test
*.out
# Stray compiled binary from `go build` in the repo root (the package lives
# at repo/pgxrepo/). Root-anchored so it never matches the package dir.
/pgxrepo

# Python caches (e.g. under scripts/)
__pycache__/
*.pyc

# Go
vendor/

# Editor
.vscode/
.idea/
*.swp

# OS
.DS_Store

# Demo / runtime artifacts
.demo-keys/
*.db
*.sqlite
*.sqlite3

# Node / TS
node_modules/
dist/
packages/*/dist/
packages/*/node_modules/

# Bench outputs (kept under scripts/bench-output/, but no runtime tmps)
/tmp/

# Env
.env
.env.local

# Local agent state
.claude/

# Beads / Dolt files (added by bd init)
.dolt/
.beads-credential-key

# JS client workspace (clients/)
clients/**/node_modules/
clients/**/dist/
clients/node_modules/
