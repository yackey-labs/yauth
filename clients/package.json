{
  "name": "yauth-clients",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix && vp fmt --write",
    "format": "vp fmt --write",
    "typecheck": "vp run -r typecheck",
    "test": "vp run -r test",
    "validate": "vp run lint:fix && vp run typecheck && vp run build",
    "validate:ci": "vp run lint && vp run typecheck && vp run build && vp run generate:check",
    "generate": "node scripts/prepare-spec.mjs && vp exec orval",
    "generate:check": "node scripts/prepare-spec.mjs && vp exec orval && git diff --exit-code openapi.json packages/client/src/generated.ts",
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "msw": "^2.15.0",
    "orval": "8.47.0",
    "typescript": "^6.0.3",
    "vite-plus": "^1.5.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "brace-expansion@<5.0.12": "^5.0.12",
      "fast-uri@<3.1.9": "^3.1.9",
      "glob@<14.0.2": "^14.0.2",
      "js-yaml@<4.3.2": "^4.3.2",
      "markdown-it@<14.3.3": "^14.3.3",
      "minimatch@<11.0.1": "^11.0.1",
      "nanoid@<3.3.18": "^3.3.18",
      "source-map-js@<1.2.2": "^1.2.2",
      "tinypool@<2.1.2": "^2.1.2"
    }
  }
}
