{
  "name": "@yackey-labs/yauth-ui-vue",
  "version": "0.45.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/yackey-labs/yauth"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./composables": {
      "import": "./dist/composables.js",
      "types": "./src/composables/index.ts",
      "default": "./src/composables/index.ts"
    }
  },
  "scripts": {
    "build": "vp build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vp test run"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@yackey-labs/yauth-client": "workspace:*",
    "@yackey-labs/yauth-shared": "workspace:*",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.4.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "peerDependencies": {
    "vue": "^3.5.45"
  }
}
