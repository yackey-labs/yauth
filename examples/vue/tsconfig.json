{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"jsx": "preserve",
		"skipLibCheck": true,
		"paths": {
			"@yackey-labs/yauth-go-client": ["../../packages/client/src/index.ts"],
			"@yackey-labs/yauth-go-shared": ["../../packages/shared/src/index.ts"],
			"@yackey-labs/yauth-go-ui-vue": ["../../packages/ui-vue/src/index.ts"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.vue", "vite-env.d.ts"]
}
