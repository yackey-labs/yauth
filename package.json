{
	"name": "yauth-go",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*",
		"examples/vue"
	],
	"scripts": {
		"build": "bun run --filter '*' build",
		"typecheck": "bun run --filter '*' typecheck",
		"test": "bun run --filter '*' test",
		"generate": "go generate ./openapi/ && bunx orval",
		"generate:check": "go generate ./openapi/ && bunx orval && git diff --exit-code packages/client/src/generated.ts packages/client/src/generated.msw.ts openapi.json",
		"clean": "rm -rf node_modules packages/*/node_modules packages/*/dist"
	},
	"devDependencies": {
		"@faker-js/faker": "^10.4.0",
		"@types/bun": "^1.3.11",
		"msw": "^2.13.2",
		"orval": "^8.7.0",
		"typescript": "^5.9.3"
	},
	"engines": {
		"node": ">=20"
	}
}
